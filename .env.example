# Chaves do LiveKit. Gere com: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=troque-me
LIVEKIT_API_SECRET=troque-me-por-um-segredo-longo

# URL interna do SFU, usada pelo token-service
LIVEKIT_URL=http://127.0.0.1:7880

# Host público (sem protocolo), usado pelo front para montar a URL do WebSocket
PUBLIC_HOST=share.seudominio.com.br

# Porta local do token-service (troque se a porta já estiver em uso na VPS)
PORT=3000

# IP público anunciado nos candidatos ICE. Deixe vazio para o LiveKit detectar sozinho;
# fixe (ex.: NODE_IP=203.0.113.10) numa VPS com network_mode: host que enxerga bridges docker.
NODE_IP=

# Consumo: seletor de métrica Prometheus dos bytes de mídia enviados pela VPS.
# Confirme na VPS: curl -s 127.0.0.1:6789/metrics | grep -i bytes
# LiveKit 1.8.x expõe livekit_packet_bytes{direction="outgoing",...} (não livekit_node_bytes_out).
# lerMetrica() casa por prefixo e soma; este valor casa as duas séries outgoing (initial+retransmit).
USAGE_METRIC=livekit_packet_bytes{direction="outgoing"
# Endpoint Prometheus do LiveKit lido pelo coletor de consumo
USAGE_URL=http://127.0.0.1:6789/metrics
USAGE_FILE=/dados/consumo.json
